<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mainController">
   <children>
      <!-- Başlık -->
      <Label layoutX="406.0" layoutY="-7.0" prefHeight="88.0" prefWidth="364.0" text="SAVED ISSUES">
         <font>
            <Font name="System Bold" size="50.0" />
         </font>
      </Label>

      <!-- Sol Menü -->
      <AnchorPane prefHeight="600.0" prefWidth="228.0" style="-fx-background-color: linear-gradient(to right, #0d54a1, #ff0000);">
         <children>
            <!-- Menü Simge ve Butonlar -->
            <ImageView fitHeight="42.0" fitWidth="39.0" layoutX="14.0" layoutY="102.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@homeIcon.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="126.0" fitWidth="118.0" layoutX="-25.0" layoutY="143.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@seacrhIcon.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="39.0" fitWidth="39.0" layoutX="14.0" layoutY="253.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@mapIcon.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="57.0" fitWidth="55.0" layoutX="6.0" layoutY="339.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@savedIssues.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="69.0" fitWidth="76.0" layoutY="412.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@profileIcon.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="55.0" fitWidth="45.0" layoutX="11.0" layoutY="501.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@settingsIcon.png" />
               </image>
            </ImageView>

            <!-- Menü Butonları -->
            <Button layoutX="60.0" layoutY="99.0" mnemonicParsing="false" onAction="#goToHomePage" style="-fx-background-color: transparent;" text="Home" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button layoutX="58.0" layoutY="180.0" mnemonicParsing="false" onAction="#goToSearchPage" style="-fx-background-color: transparent;" text="Search" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button layoutX="59.0" layoutY="251.0" mnemonicParsing="false" onAction="#goToMapPage" style="-fx-background-color: transparent;" text="Map" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button layoutX="57.0" layoutY="345.0" mnemonicParsing="false" style="-fx-background-color: transparent;" text="Saved Issues" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button layoutX="59.0" layoutY="425.0" mnemonicParsing="false" onAction="#goToProfilePage" style="-fx-background-color: transparent;" text="Profile" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button layoutX="77.0" layoutY="502.0" mnemonicParsing="false" onAction="#goToOptionPage" style="-fx-background-color: transparent;" text="Settings" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>

      <!-- Kaydedilen Issues Listesi -->
      <ListView fx:id="savedIssuesListView" layoutX="228.0" layoutY="69.0" prefHeight="531.0" prefWidth="672.0" />
   </children>
</AnchorPane>
